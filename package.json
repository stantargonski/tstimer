{
  "name": "tstimer",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:algs": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-algs.ts",
    "preview": "vite preview",
    "check:cube": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-cube.ts",
    "check:scramble": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-scramble.ts",
    "check": "npm run check:algs && npm run check:cube && npm run check:scramble && npm run check:timer && npm run check:stats && npm run check:cstimer && npm run check:keys",
    "check:keys": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-keys.ts",
    "check:cstimer": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-cstimer.ts",
    "check:timer": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-timer.ts",
    "check:stats": "node --experimental-strip-types --import ./scripts/ts-loader.mjs scripts/check-stats.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
